# Copy to .env and fill in. .env is gitignored and must never be committed.
# On Colab, use Secrets (key icon in the left sidebar) instead of this file.

# Primary LLM inference — free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Automatic fallback when Groq rate-limits. https://openrouter.ai/keys
# Strongly recommended: Task 3's agent runs long enough to hit a free-tier limit.
OPENROUTER_API_KEY=

# Task 2B only — pushing the merged model. Needs WRITE scope.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: fourth news source in Task 1A. Skipped silently if unset.
# https://newsapi.org/register
NEWSAPI_KEY=
