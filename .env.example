# Copy to .env and fill in. .env is gitignored and must never be committed.
# On Colab, use Secrets (key icon in the left sidebar) instead of this file.

# Primary LLM inference — free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Automatic fallback when Groq rate-limits. https://openrouter.ai/keys
# Strongly recommended: Task 3's agent runs long enough to hit a free-tier limit.
OPENROUTER_API_KEY=

# Third provider, and the one with the most usable free headroom. No credit card.
# Note the per-MODEL daily caps: gemini-3.6-flash and gemini-3.5-flash allow only
# 20 requests/day each, so the client prefers the -flash-lite and -preview
# variants, which keep serving. Groq allows 200,000 tokens/day and OpenRouter 50
# requests/day; a few full Task 3 runs exhaust both.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Task 2B only — pushing the merged model. Needs WRITE scope.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: fourth news source in Task 1A. Skipped silently if unset.
# https://newsapi.org/register
NEWSAPI_KEY=
